{
  "name": "server",
  "version": "26.0.0",
  "description": "",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "build": "pnpm --filter emails build && tsdown",
    "format": "prettier --write \"**/*.{ts,md,json,js,yaml}\"",
    "gen:docs": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 1000",
    "fix:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=1000",
    "check:types": "node ../../node_modules/typescript-7/bin/tsc --noEmit",
    "clean": "rm -rf node_modules dist docs && echo 'Cleanup complete!'"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/request-ip": "^0.0.41",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inversify": "^8.2.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "tsdown": "^0.22.14",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.0.0"
}
